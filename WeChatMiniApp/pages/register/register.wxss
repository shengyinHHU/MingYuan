page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
}

.auth-page {
  min-height: 100vh;
  padding-bottom: 42rpx;
  box-sizing: border-box;
}

.brand {
  margin: 0 24rpx;
  padding: 34rpx 28rpx 30rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 56%, #fff3db 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.logo {
  width: 420rpx;
}

.badge {
  display: inline-flex;
  margin-top: 28rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(15, 88, 168, 0.1);
  color: #0f58a8;
  font-size: 23rpx;
  font-weight: 700;
}

.title {
  margin-top: 18rpx;
  color: #0b326a;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.subtitle {
  margin-top: 14rpx;
  color: #59687d;
  font-size: 26rpx;
  line-height: 1.65;
}

.panel {
  margin: 24rpx;
  padding: 26rpx;
  border: 1rpx solid rgba(18, 41, 72, 0.06);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.05);
}

.notice {
  padding: 24rpx;
  border-radius: 16rpx;
  background: #f8fbff;
  border: 1rpx solid #e2ebf7;
}

.notice-title {
  color: #0b326a;
  font-size: 30rpx;
  font-weight: 800;
}

.notice-text {
  margin-top: 12rpx;
  color: #59687d;
  font-size: 25rpx;
  line-height: 1.65;
}

.wechat-btn {
  height: 88rpx;
  margin-top: 28rpx;
  border-radius: 16rpx;
  background: #0f58a8;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
  box-shadow: 0 12rpx 24rpx rgba(15, 88, 168, 0.22);
}

.role-tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.role-tab {
  height: 70rpx;
  border: 1rpx solid #d8e4f2;
  border-radius: 14rpx;
  color: #43536a;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 70rpx;
  text-align: center;
  background: #ffffff;
}

.role-tab.active {
  border-color: #0f58a8;
  color: #0f58a8;
  background: #edf6ff;
}

.dev-btn {
  height: 82rpx;
  margin-top: 18rpx;
  border-radius: 16rpx;
  background: #eef3f9;
  color: #1e314d;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 82rpx;
}
