<view class="auth-page">
  <view class="brand">
    <image class="logo" src="/images/logo.png" mode="widthFix"></image>
    <view class="title">欢迎来到名远教育</view>
    <view class="subtitle">连接家校，让每一次成长都有陪伴</view>
  </view>

  <view class="panel">
    <view class="panel-title">手机号登录</view>
    <view class="panel-subtitle">登录后自动进入您已授权的工作台</view>
    <view class="field-label">手机号码</view>
    <view class="phone-field"><text class="phone-prefix">+86</text><input class="account-input" type="number" maxlength="11" value="{{phone}}" bindinput="phoneInput" placeholder="请输入手机号" placeholder-class="input-placeholder" disabled="{{submitting || codeSending}}"/></view>
    <view class="field-label">验证码</view>
    <view class="code-row"><input class="account-input code-input" type="number" maxlength="6" value="{{verificationCode}}" bindinput="verificationInput" placeholder="请输入6位验证码" placeholder-class="input-placeholder" disabled="{{submitting}}"/><button class="code-button" bindtap="sendCode" loading="{{codeSending}}" disabled="{{configLoading || !phoneLoginEnabled || codeSending || submitting || cooldown > 0}}">{{cooldown ? cooldown + '秒后重试' : '获取验证码'}}</button></view>
    <view class="development-hint" wx:if="{{developmentCodeMode}}"><text class="development-label">开发测试</text><text>不发送短信，验证码5分钟内有效</text></view>
    <view class="test-code" wx:if="{{developmentCodeMode && developmentCode}}">测试验证码：{{developmentCode}}</view>
    <view class="teacher-error" wx:if="{{loginError}}">{{loginError}}</view>
    <view class="teacher-hint" wx:if="{{!configLoading && !phoneLoginEnabled}}">短信登录暂未开通，请联系管理员。</view>
    <button class="wechat-btn" bindtap="handlePhoneCodeLogin" loading="{{submitting}}" disabled="{{configLoading || !phoneLoginEnabled || submitting || codeSending}}">登录 / 注册</button>
    <view class="register-note">未注册手机号将自动创建家长账号</view>
  </view>
  <view class="auth-footer">教师、教务及管理员身份由管理员授权<view>一个账号，多种身份，登录后自动识别</view></view>
</view>
