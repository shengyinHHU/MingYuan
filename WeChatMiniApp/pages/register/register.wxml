<view class="auth-page">
  <view class="brand">
    <image class="logo" src="/images/logo.png" mode="widthFix"></image>
    <view class="badge">开发登录</view>
    <view class="title">选择角色进入小程序</view>
    <view class="subtitle">开发阶段可直接切换家长、教师、管理员，并获得对应若依鉴权 token。</view>
  </view>

  <view class="panel">
    <view class="role-tabs">
      <view
        class="role-tab {{item.className}}"
        wx:for="{{devRoles}}"
        wx:key="key"
        data-role="{{item.key}}"
        bindtap="chooseDevRole"
      >
        {{item.name}}
      </view>
    </view>

    <view class="teacher-select" wx:if="{{devRole === 'teacher'}}">
      <view class="teacher-title">选择登录教师</view>
      <picker mode="selector" range="{{teacherOptions}}" range-key="label" value="{{teacherIndex}}" bindchange="chooseTeacher" disabled="{{teachersLoading || submitting || !teachers.length}}">
        <view class="teacher-picker">{{teachersLoading ? '正在加载教师…' : (teacherLabel || '请选择教师')}} ▾</view>
      </picker>
      <view class="teacher-hint">仅用于开发测试，进入后查看所选教师负责的班级。</view>
      <view class="teacher-error" wx:if="{{teacherError}}">{{teacherError}}</view>
      <button size="mini" bindtap="loadTeachers" disabled="{{teachersLoading || submitting}}">刷新教师列表</button>
    </view>

    <view class="teacher-select" wx:if="{{devRole === 'parent'}}">
      <view class="teacher-title">选择登录家长</view>
      <picker mode="selector" range="{{parentOptions}}" range-key="label" value="{{parentIndex}}" bindchange="chooseParent" disabled="{{parentsLoading || submitting || !parents.length}}">
        <view class="teacher-picker">{{parentsLoading ? '正在加载家长…' : (parentLabel || '请选择家长（可选，不选则用默认家长）')}} ▾</view>
      </picker>
      <view class="teacher-hint">开发测试用：切换不同家长身份提交 / 查看作业。测试账号排在列表最前。</view>
      <view class="teacher-error" wx:if="{{parentError}}">{{parentError}}</view>
      <button size="mini" bindtap="loadParents" disabled="{{parentsLoading || submitting}}">刷新家长列表</button>
    </view>

    <view class="notice">
      <view class="notice-title">名远教育</view>
      <view class="notice-text">当前开发模式会向若依后端申请所选角色的真实登录 token，方便继续联调角色权限和接口。</view>
    </view>

    <button
      class="wechat-btn"
      wx:if="{{devRole !== 'teacher' && selectMode !== 'parent'}}"
      open-type="getPhoneNumber"
      bindgetphonenumber="handlePhoneLogin"
      loading="{{submitting}}"
    >手机号授权登录</button>

    <button class="dev-btn" bindtap="handleDevLogin" loading="{{submitting}}" disabled="{{submitting || (devRole === 'teacher' && (teachersLoading || !devTeacherId)) || (devRole === 'parent' && selectMode === 'parent' && (parentsLoading || !devParentId))}}">{{devRole === 'teacher' ? '以所选教师身份进入' : (devRole === 'parent' ? (devParentId ? '以所选家长身份进入' : '以默认家长进入') : '开发模拟登录')}}</button>
  </view>
</view>
