page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
}

.page {
  min-height: 100vh;
  padding-bottom: 54rpx;
}

.header {
  margin: 0 24rpx 22rpx;
  padding: 30rpx 28rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 56%, #fff3db 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.logo {
  width: 320rpx;
}

.title {
  margin-top: 22rpx;
  color: #0b326a;
  font-size: 44rpx;
  font-weight: 800;
}

.summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin: 0 24rpx 24rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.05);
}

.summary-item {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.summary-value {
  color: #0f58a8;
  font-size: 42rpx;
  font-weight: 800;
}

.summary-label {
  color: #647286;
  font-size: 24rpx;
  font-weight: 700;
}

.summary-btn,
.primary-btn {
  height: 72rpx;
  padding: 0 26rpx;
  border-radius: 14rpx;
  background: #0f58a8;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.period {
  margin: 24rpx;
}

.period-title {
  margin-bottom: 14rpx;
  color: #172033;
  font-size: 31rpx;
  font-weight: 800;
}

.course-card {
  position: relative;
  display: flex;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(18, 41, 72, 0.06);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.05);
}

.time-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: #eef5ff;
  color: #0f58a8;
  font-size: 24rpx;
  font-weight: 800;
}

.course-main {
  flex: 1;
  min-width: 0;
}

.course-name {
  padding-right: 92rpx;
  color: #172033;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
}

.course-meta {
  margin-top: 8rpx;
  color: #6e7a8c;
  font-size: 23rpx;
  line-height: 1.35;
}

.student {
  display: inline-flex;
  margin-top: 14rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3dc;
  color: #b87308;
  font-size: 22rpx;
  font-weight: 800;
}

.pay-tag {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eaf7f1;
  color: #15875d;
  font-size: 22rpx;
  font-weight: 800;
}

.empty {
  margin: 24rpx;
  padding: 54rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.05);
}

.empty-title {
  margin-bottom: 24rpx;
  color: #778397;
  font-size: 27rpx;
  font-weight: 700;
}
