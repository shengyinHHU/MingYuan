page{min-height:100vh;background:#f4f7fb;color:#172033}.page{padding-bottom:40rpx}.header{margin:0 24rpx 22rpx;padding:36rpx 28rpx;border-radius:0 0 24rpx 24rpx;background:linear-gradient(145deg,#fff,#eaf3ff 56%,#fff3db);box-shadow:0 18rpx 46rpx #0d4c911f}.header-title{color:#0b326a;font-size:44rpx;font-weight:800}.header-subtitle{margin-top:12rpx;color:#59687d;font-size:25rpx}.card{margin:0 24rpx 20rpx;padding:24rpx;border-radius:20rpx;background:#fff;box-shadow:0 8rpx 24rpx #14325a0f}.title{font-size:30rpx;font-weight:700}.meta{margin-top:12rpx;color:#69778b;font-size:24rpx}.status{color:#2670c8}.empty,.loading{padding:100rpx 0;text-align:center;color:#8993a4}.class-tabs{white-space:nowrap;margin:0 24rpx 14rpx}.class-tab{display:inline-block;margin-right:14rpx;padding:12rpx 26rpx;border-radius:30rpx;background:#fff;color:#52627a;font-size:25rpx}.class-tab-active{background:#0f3f7a;color:#fff;font-weight:700}.tabs{display:flex;margin:0 24rpx 20rpx;padding:8rpx;border-radius:16rpx;background:#fff;box-shadow:0 6rpx 18rpx #14325a0f}.tab{flex:1;text-align:center;padding:16rpx 0;font-size:26rpx;color:#66748a;border-radius:12rpx}.tab-active{background:#1768c2;color:#fff;font-weight:700}.score{color:#d4760a;font-weight:700}
