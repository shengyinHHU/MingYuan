<view class="page"><view class="hero"><view class="heading">{{role === 'teacher' ? '资料草稿' : '资料管理'}}</view><view class="muted">{{role === 'teacher' ? '提交电子PDF草稿，由管理员审核上架' : '维护商品、图片与库存，发布规则由服务器校验'}}</view><button wx:if="{{role}}" class="small primary" disabled="{{submitting}}" bindtap="openForm">新增{{role === 'teacher' ? '草稿' : '商品'}}</button></view>
  <view wx:if="{{loading}}" class="state">正在加载…</view><view wx:if="{{error}}" class="state error">{{error}}<button bindtap="onShow">重新加载</button></view><view wx:elif="{{!loading && !list.length && role}}" class="state">暂无资料</view>
  <view wx:for="{{list}}" wx:key="materialId" class="card"><view class="row"><image class="cover" src="{{item.displayCover}}" mode="aspectFill"/><view class="grow"><view class="title">{{item.title}}</view><view class="muted">{{item.deliveryType === 'PHYSICAL' ? '纸质配送' : '电子下载'}} · {{item.shelfText}}</view><view class="price">¥{{item.price}}</view><view wx:if="{{item.deliveryType === 'PHYSICAL'}}" class="muted">库存 {{item.stockQuantity}} / 预占 {{item.stockLocked}} / 可售 {{item.availableStock}}</view></view></view><view class="actions"><button wx:if="{{role === 'admin' || item.shelfStatus === '2'}}" class="small" data-id="{{item.materialId}}" bindtap="edit" disabled="{{submitting}}">编辑</button><button wx:if="{{role === 'admin'}}" class="small" data-id="{{item.materialId}}" data-status="{{item.shelfStatus === '1' ? '0' : '1'}}" bindtap="shelf" disabled="{{submitting}}">{{item.shelfStatus === '1' ? '下架' : '上架'}}</button><button wx:if="{{role === 'admin' || item.shelfStatus === '2'}}" class="small" data-id="{{item.materialId}}" bindtap="remove" disabled="{{submitting}}">移除</button></view></view>
  <view wx:if="{{showForm}}" class="editor card"><view class="heading">{{form.materialId ? '编辑商品' : '新增商品'}}</view>
    <view class="label">商品名称（最多100字）</view><input value="{{form.title}}" maxlength="100" data-field="title" bindinput="input"/>
    <view class="label">简短卖点</view><input value="{{form.subtitle}}" maxlength="200" data-field="subtitle" bindinput="input"/>
    <view class="row"><view class="grow"><view class="label">学科</view><picker range="{{subjects}}" range-key="dictLabel" value="{{subjectIndex}}" data-kind="subject" bindchange="select"><view class="picker">{{subjectIndex >= 0 ? subjects[subjectIndex].dictLabel : '请选择学科'}}</view></picker></view><view class="grow"><view class="label">年级</view><picker range="{{grades}}" range-key="dictLabel" value="{{gradeIndex}}" data-kind="grade" bindchange="select"><view class="picker">{{gradeIndex >= 0 ? grades[gradeIndex].dictLabel : '请选择年级'}}</view></picker></view></view>
    <view class="label">资料类型（选填）</view><picker range="{{materialTypes}}" range-key="dictLabel" value="{{typeIndex}}" data-kind="type" bindchange="select"><view class="picker">{{typeIndex >= 0 ? materialTypes[typeIndex].dictLabel : '请选择资料类型'}}</view></picker>
    <view class="label">教材版本（选填）</view><input value="{{form.textbookVersion}}" maxlength="100" data-field="textbookVersion" bindinput="input"/>
    <view wx:if="{{role === 'admin'}}"><view class="label">交付方式</view><picker range="{{['纸质配送', '电子下载']}}" value="{{form.deliveryType === 'DIGITAL' ? 1 : 0}}" bindchange="deliveryChange"><view class="picker">{{form.deliveryType === 'DIGITAL' ? '电子下载' : '纸质配送'}}</view></picker></view>
    <view class="title">图片与描述</view><view class="muted">JPG/PNG每张不超过5MB；封面加轮播最多5张。</view>
    <view wx:if="{{form.coverUrl}}" class="thumb"><image src="{{form.coverUrl}}" mode="aspectFill"/><button class="small" data-kind="cover" bindtap="removeImage">移除封面</button></view><button class="small" data-kind="cover" bindtap="chooseImages" disabled="{{submitting}}">上传封面</button>
    <view class="thumbs"><view wx:for="{{form.images}}" wx:key="imageUrl" class="thumb"><image src="{{item.imageUrl}}" mode="aspectFill"/><view class="muted">{{item.imageType === 'GALLERY' ? '轮播' : '详情'}} {{index + 1}}</view><button class="small" data-index="{{index}}" bindtap="removeImage" disabled="{{submitting}}">移除</button></view></view>
    <view class="actions"><button class="small" data-kind="GALLERY" bindtap="chooseImages" disabled="{{submitting}}">增加轮播图</button><button class="small" data-kind="DETAIL" bindtap="chooseImages" disabled="{{submitting}}">增加详情图</button></view>
    <view class="label">资料简介</view><textarea value="{{form.intro}}" maxlength="1000" data-field="intro" bindinput="input"/><view class="label">详情描述（上架必填）</view><textarea value="{{form.detailText}}" maxlength="-1" data-field="detailText" bindinput="input"/>
    <view class="title">价格与库存</view><view class="row"><view class="grow"><view class="label">售价（元）</view><input type="digit" value="{{form.price}}" data-field="price" bindinput="input"/></view><view class="grow"><view class="label">计量单位</view><input value="{{form.unit}}" maxlength="20" data-field="unit" bindinput="input"/></view></view>
    <view class="label">单次限购（1—99，电子固定1）</view><input type="number" value="{{form.purchaseLimit}}" disabled="{{form.deliveryType === 'DIGITAL'}}" data-field="purchaseLimit" bindinput="input"/>
    <block wx:if="{{form.deliveryType === 'PHYSICAL'}}"><view class="label">库存{{form.materialId ? '（编辑时使用下方调整）' : ''}}</view><input type="number" value="{{form.stockQuantity}}" disabled="{{!!form.materialId}}" data-field="stockQuantity" bindinput="input"/><view class="label">固定运费（元）</view><input type="digit" value="{{form.shippingFee}}" data-field="shippingFee" bindinput="input"/><view class="label">发货地</view><input value="{{form.shipFrom}}" maxlength="200" data-field="shipFrom" bindinput="input"/><view class="label">预计发货天数</view><input type="number" value="{{form.dispatchDays}}" data-field="dispatchDays" bindinput="input"/>
      <view wx:if="{{form.materialId && role === 'admin'}}" class="notice"><view class="title">受控库存调整</view><view class="muted">正数增加，负数减少。库存不能低于预占。</view><input type="text" value="{{stockDelta}}" placeholder="例如 10 或 -2" data-field="stockDelta" bindinput="stockInput"/><input value="{{stockRemark}}" placeholder="填写调整原因" maxlength="500" data-field="stockRemark" bindinput="stockInput"/><button class="small" bindtap="adjustStock" disabled="{{submitting}}">提交库存调整</button></view>
    </block><view wx:else class="notice"><view>私有PDF（不超过10MB）</view><view>{{file.name || form.fileName || '尚未选择文件'}}</view><button class="small" bindtap="chooseFile" disabled="{{submitting}}">选择PDF</button></view>
    <view class="label">排序（数字越大越靠前）</view><input type="number" value="{{form.sortOrder}}" data-field="sortOrder" bindinput="input"/>
    <view class="actions"><button bindtap="closeForm" disabled="{{submitting}}">关闭</button><button bindtap="submit" data-publish="0" disabled="{{submitting}}" loading="{{submitting}}">保存草稿</button><button wx:if="{{role === 'admin'}}" class="primary" bindtap="submit" data-publish="1" disabled="{{submitting}}">保存并上架</button></view>
  </view>
</view>
