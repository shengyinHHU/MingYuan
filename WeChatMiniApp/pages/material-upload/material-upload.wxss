page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
}

.page {
  min-height: 100vh;
  padding-bottom: 56rpx;
}

.header {
  position: relative;
  margin: 0 24rpx 22rpx;
  padding: 36rpx 28rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 56%, #fff3db 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.header-title {
  color: #0b326a;
  font-size: 44rpx;
  font-weight: 800;
}

.header-subtitle {
  margin-top: 12rpx;
  color: #59687d;
  font-size: 25rpx;
}

.header-action {
  position: absolute;
  top: 36rpx;
  right: 28rpx;
  padding: 12rpx 22rpx;
  border-radius: 14rpx;
  background: #0f58a8;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.list {
  margin: 0 24rpx;
}

.m-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(20, 50, 90, 0.06);
}

.m-main {
  flex: 1;
  min-width: 0;
}

.m-title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.m-meta {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
  flex-wrap: wrap;
}

.tag {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: #eef4ff;
  color: #2c6bc4;
  font-size: 22rpx;
}

.shelf {
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.shelf.on {
  background: #e6f7ee;
  color: #1aa56c;
}

.shelf.off {
  background: #f1f3f7;
  color: #8993a4;
}

.m-sub {
  display: flex;
  gap: 16rpx;
  margin-top: 10rpx;
  align-items: center;
  color: #8993a4;
  font-size: 22rpx;
}

.price {
  color: #e6532a;
  font-size: 26rpx;
  font-weight: 700;
}

.price.free {
  color: #1aa56c;
}

.m-action {
  margin-left: 18rpx;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  background: #fdeaea;
  color: #c93b3b;
  font-size: 24rpx;
  flex-shrink: 0;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #8993a4;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
}

.empty-action {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 32rpx;
  border-radius: 16rpx;
  background: #0f58a8;
  color: #ffffff;
  font-size: 26rpx;
}

.loading {
  padding: 40rpx 0;
  text-align: center;
  color: #8993a4;
  font-size: 24rpx;
}

.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(13, 36, 67, 0.45);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 90vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  z-index: 101;
  overflow-y: auto;
}

.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18rpx;
}

.sheet-title {
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
}

.sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #f1f3f7;
  color: #526175;
  font-size: 36rpx;
  line-height: 56rpx;
  text-align: center;
}

.form-row {
  margin-bottom: 18rpx;
}

.form-label {
  margin-bottom: 8rpx;
  color: #59687d;
  font-size: 24rpx;
}

.form-input {
  height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce5f2;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
  box-sizing: border-box;
}

.form-picker {
  height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce5f2;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
  line-height: 76rpx;
  color: #8993a4;
}

.form-picker.filled {
  color: #172033;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid #dce5f2;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
  box-sizing: border-box;
}

.file-picker {
  height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx dashed #b6c8e1;
  border-radius: 12rpx;
  background: #f7faff;
  font-size: 26rpx;
  line-height: 76rpx;
  color: #172033;
}

.file-picker .placeholder {
  color: #8993a4;
}

.sheet-footer {
  margin-top: 12rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #0f58a8;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.btn[disabled] {
  background: #9bb6d8;
  color: #ffffff;
}
