.page { padding: 28rpx; background: #f4f7fb; min-height: 100vh; box-sizing: border-box; color: #25354a; }
.title { font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.muted { color: #738196; font-size: 25rpx; line-height: 1.8; }
.search { display: flex; align-items: center; gap: 12rpx; margin: 24rpx 0; }
.search input { flex: 1; min-width: 0; background: #fff; border-radius: 12rpx; padding: 20rpx; font-size: 24rpx; }
.search button { flex-shrink: 0; margin: 0; }
.back { color: #356acc; padding: 12rpx 0; }
.card { background: #fff; border-radius: 18rpx; padding: 26rpx; margin: 20rpx 0; font-size: 27rpx; line-height: 1.8; }
.empty { padding: 32rpx 0; text-align: center; color: #738196; }
.history { border-top: 1rpx solid #eef1f6; margin-top: 18rpx; padding-top: 18rpx; }
