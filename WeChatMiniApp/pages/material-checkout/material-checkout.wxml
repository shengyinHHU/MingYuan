<view class="page">
  <view class="hero"><view class="heading">确认订单</view></view><view class="notice">模拟支付，不会真实扣款。订单创建后30分钟内可在订单详情确认模拟支付。</view>
  <view wx:if="{{pending}}" class="notice">正在核对上次提交结果，重试将使用相同商品、数量、地址和留言。</view>
  <view wx:if="{{loading}}" class="state">正在加载…</view><view wx:if="{{error}}" class="state error">{{error}}<button wx:if="{{!pending}}" bindtap="load">重新加载</button></view>
  <block wx:if="{{detail}}"><view class="card row"><image class="cover" src="{{detail.coverUrl}}" mode="aspectFill"/><view class="grow"><view class="title">{{detail.title}}</view><view class="price">{{detail.priceText}}</view><view class="tag">{{detail.deliveryText}}</view></view></view>
    <view class="card"><view class="row"><text>购买数量</text><view class="stepper"><button class="small" data-delta="-1" bindtap="changeQuantity" disabled="{{pending || submitting || detail.deliveryType === 'DIGITAL' || quantity <= 1}}">−</button><text>{{quantity}}</text><button class="small" data-delta="1" bindtap="changeQuantity" disabled="{{pending || submitting || detail.deliveryType === 'DIGITAL'}}">＋</button></view></view></view>
    <view wx:if="{{detail.deliveryType === 'PHYSICAL'}}" class="card" bindtap="chooseAddress"><view class="row"><view class="title">收货地址</view><text class="tag">填写 / 选择</text></view><block wx:if="{{address}}"><view>{{address.receiverName}}　{{address.receiverPhone}}</view><view class="muted">{{address.provinceName}}{{address.cityName}}{{address.districtName}}{{address.detailAddress}}</view><view wx:if="{{!address.addressId}}" class="muted">仅用于本次订单</view></block><view wx:else class="muted">请填写完整收货地址，可选择保存到地址簿</view></view>
    <view class="card"><view class="label">买家留言</view><textarea maxlength="500" value="{{buyerRemark}}" disabled="{{pending || submitting}}" bindinput="onRemark" placeholder="选填，最多500字"/><view class="row"><text>商品小计</text><text>¥{{detail.price}} × {{quantity}}</text></view><view class="row"><text>运费</text><text>¥{{detail.deliveryType === 'PHYSICAL' ? detail.shippingFee : '0.00'}}</text></view><view class="row"><text>预计应付</text><text class="price">¥{{estimatedTotal}}</text></view><view class="muted">订单最终金额以服务端创建后的订单为准。</view></view>
  </block><view class="bottom"><button class="primary" loading="{{submitting}}" disabled="{{submitting || (!pending && (!detail || loading || error))}}" bindtap="submit">{{pending ? '核对并重试提交' : '提交订单'}}</button></view>
</view>
