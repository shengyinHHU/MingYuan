<view class="page">
  <view class="title">{{editing ? (form.classMode === '2' ? '修改一对一课程' : '修改排课') : '新增一对一课程'}}</view>
  <view class="note">当前教师：{{teacherName}}。排课与若依共用数据，学科和教师等级由后台配置。</view>
  <view class="message" wx:if="{{loading}}">正在加载…</view>
  <view class="message error" wx:if="{{error}}">{{error}}<button size="mini" bindtap="loadForm">重试</button></view>
  <view wx:if="{{!loading && !error && simpleMode}}">
    <view class="note">授课学科：{{form.subjectName || '尚未配置，请联系后台管理员'}} · {{teacherLevelText}}</view>
    <view class="field"><view>上课地点</view><input maxlength="255" value="{{form.lessonLocation}}" data-field="lessonLocation" bindinput="input" placeholder="请输入详细上课地点，可填写机构外地点" disabled="{{submitting}}" /></view>
    <view class="field"><view>课名</view><input maxlength="100" value="{{form.courseClassName}}" data-field="courseClassName" bindinput="input" placeholder="请输入课名" disabled="{{submitting}}" /></view>
    <view class="field" wx:for="{{pickers}}" wx:key="field"><view>{{item.label}}</view><picker range="{{item.options}}" range-key="label" value="{{item.index}}" data-field="{{item.field}}" bindchange="choose" disabled="{{submitting}}"><view class="picker">{{item.text}}　›</view></picker></view>
    <view class="field"><view>开始日期</view><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="chooseDate" disabled="{{submitting}}"><view class="picker">{{form.startDate}}　›</view></picker></view>
    <view class="field"><view>开始时间</view><picker mode="time" value="{{startPickerTime}}" data-field="startTime" bindchange="chooseTime" disabled="{{submitting}}"><view class="picker">{{form.startTime}}　›</view></picker><view class="note">固定2小时，结束时间：{{endPreview || '请选择早于22:00的时间'}}</view></view>
    <view class="field"><view>持续周数</view><picker range="{{weekOptions}}" value="{{weeks - 1}}" bindchange="chooseWeeks" disabled="{{submitting}}"><view class="picker">{{weeks}}周　›</view></picker><view class="note">1门课程包含{{weeks}}个课次，每周同一天、同一时段。家长每次选择其中一个日期报名。最后一次：{{lastDate}}</view></view>
    <button class="save" loading="{{submitting}}" disabled="{{submitting || (!editing && !subjectConfigured)}}" bindtap="save">{{editing ? '保存一对一课程' : '创建一对一课程'}}</button>
    <button wx:if="{{editing}}" class="delete" disabled="{{submitting}}" bindtap="remove">删除课程</button>
  </view>
  <view wx:if="{{!loading && !error && editing && !simpleMode}}">
    <view class="field" wx:if="{{form.classMode === '2'}}"><view>上课地点</view><input maxlength="255" value="{{form.lessonLocation}}" data-field="lessonLocation" bindinput="input" disabled="{{submitting}}" /></view>
    <view class="field" wx:if="{{editing}}"><view>排课编码（只读）</view><view class="value">{{form.scheduleCode}}</view></view>
    <view class="field"><view>课程班名称</view><input maxlength="100" value="{{form.courseClassName}}" data-field="courseClassName" bindinput="input" placeholder="请输入课程班名称" disabled="{{submitting}}" /></view>
    <view class="field"><view>课程年份</view><input type="number" maxlength="4" value="{{form.courseYear}}" data-field="courseYear" bindinput="input" disabled="{{submitting}}" /></view>
    <view class="field" wx:for="{{pickers}}" wx:key="field"><view>{{item.label}}</view><picker range="{{item.options}}" range-key="label" value="{{item.index}}" data-field="{{item.field}}" bindchange="choose" disabled="{{submitting}}"><view class="picker">{{item.text}}　›</view></picker></view>
    <view class="field"><view>开始时间</view><picker mode="time" value="{{startPickerTime}}" data-field="startTime" bindchange="chooseTime" disabled="{{submitting}}"><view class="picker">{{form.startTime || '请选择开始时间'}}　›</view></picker></view>
    <view class="field"><view>结束时间</view><picker mode="time" value="{{endPickerTime}}" data-field="endTime" bindchange="chooseTime" disabled="{{submitting}}"><view class="picker">{{form.endTime || '请选择结束时间'}}　›</view></picker></view>
    <view class="field"><view>开课日期</view><picker mode="date" value="{{form.startDate}}" data-field="startDate" bindchange="chooseDate" disabled="{{submitting}}"><view class="picker">{{form.startDate || '待配置'}}　›</view></picker></view>
    <view class="field"><view>结课日期</view><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="chooseDate" disabled="{{submitting}}"><view class="picker">{{form.endDate || '待配置'}}　›</view></picker></view>
    <view class="note">现有“每周一次”按周六／周日计算；暑假一期、二期等使用“上5天休1天”。缺日期可保存为待排。有签到历史的课程请通过调课管理调整日期与时间。</view>
    <view class="field" wx:if="{{editing}}"><view>已报名人数（只读）</view><view class="value">{{enrolledCount}}</view></view>
    <view class="field"><view>备注</view><textarea maxlength="500" value="{{form.remark}}" data-field="remark" bindinput="input" placeholder="选填" disabled="{{submitting}}" /></view>
    <button class="save" loading="{{submitting}}" disabled="{{submitting}}" bindtap="save">保存排课</button>
    <button wx:if="{{editing}}" class="delete" disabled="{{submitting}}" bindtap="remove">删除排课</button>
  </view>
</view>
