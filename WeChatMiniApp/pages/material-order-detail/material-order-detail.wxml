<view class="page"><view wx:if="{{loading}}" class="state">正在加载订单…</view><view wx:elif="{{error}}" class="state error">{{error}}<button bindtap="loadDetail">重试</button></view>
  <block wx:if="{{detail}}"><view class="hero"><view class="heading">{{detail.statusText}}</view><view class="muted">订单 {{detail.orderCode}}</view><view wx:if="{{detail.canPay}}" class="muted">支付截止 {{detail.expireTime}}</view></view><view class="notice">模拟支付，不会真实扣款。{{paymentText}}</view>
    <view class="card"><view wx:for="{{detail.items}}" wx:key="itemId" class="row"><image class="cover" src="{{item.coverUrl}}" mode="aspectFill"/><view class="grow"><view class="title">{{item.materialTitle}}</view><view class="muted">{{item.subjectLabel}} · {{item.gradeLabel}}</view><view>¥{{item.unitPrice}} × {{item.quantity}}{{item.unit}}</view><view class="muted">商品金额 ¥{{item.lineAmount}}</view></view></view></view>
    <view class="card"><view class="row"><text>商品金额</text><text>¥{{detail.goodsAmount}}</text></view><view class="row"><text>运费</text><text>¥{{detail.shippingAmount}}</text></view><view class="row"><text>应付</text><text class="price">¥{{detail.payableAmount}}</text></view><view class="row"><text>已付 / 已退</text><text>¥{{detail.amount}} / ¥{{detail.refundedAmount}}</text></view><view class="muted">支付方式 {{detail.payment.channel || '未支付'}}</view></view>
    <view wx:if="{{detail.deliveryType === 'PHYSICAL'}}" class="card"><view class="title">订单收货地址</view><view>{{detail.receiverName}}　{{detail.receiverPhone}}</view><view class="muted">{{detail.provinceName}}{{detail.cityName}}{{detail.districtName}}{{detail.detailAddress}}</view></view>
    <view wx:if="{{detail.shipment}}" class="card"><view class="title">物流信息</view><view>{{detail.shipment.carrierName}}　{{detail.shipment.trackingNo}}</view><view class="muted">发货时间 {{detail.shipment.shipTime}}</view><view wx:if="{{detail.shipment.receiveTime}}" class="muted">收货时间 {{detail.shipment.receiveTime}}</view></view>
    <view class="card"><view class="title">订单记录</view><view class="muted">创建时间 {{detail.createTime}}</view><view wx:if="{{detail.payTime}}" class="muted">支付时间 {{detail.payTime}}</view><view wx:if="{{detail.buyerRemark}}" class="detail-text">买家留言：{{detail.buyerRemark}}</view><view wx:for="{{detail.logs}}" wx:key="logId" class="timeline"><view>{{item.eventText}}　{{item.statusText}}</view><view class="muted">{{item.createTime}}</view></view></view>
    <view class="bottom actions"><button wx:if="{{detail.canPay}}" class="small" disabled="{{busy}}" data-action="cancel" bindtap="action">取消订单</button><button wx:if="{{detail.canPay}}" class="primary" disabled="{{busy}}" loading="{{busy}}" bindtap="pay">确认模拟支付</button><button wx:if="{{detail.canReceive}}" class="primary" disabled="{{busy}}" data-action="receive" bindtap="action">确认收货</button><button wx:if="{{detail.canDownload}}" class="primary" bindtap="download">下载PDF</button><button wx:if="{{!detail.canPay && !detail.canReceive && !detail.canDownload}}" bindtap="loadDetail">刷新状态</button></view>
  </block>
</view>
