.page { padding: 24rpx; background: #f4f7fb; min-height: 100vh; color: #24344b; }
.card { background: white; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; line-height: 1.9; }
.title { font-size: 32rpx; font-weight: 600; }
.muted { color: #718096; font-size: 25rpx; }
.search { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.search input { flex: 1; min-width: 0; font-size: 27rpx; background: #f4f7fb; padding: 16rpx; border-radius: 10rpx; }
.search button { margin: 0; flex-shrink: 0; }
.filter { margin-top: 18rpx; color: #2563eb; }
.group-title, .row { display: flex; justify-content: space-between; gap: 16rpx; }
.group-title { padding: 20rpx 8rpx; font-weight: 600; }
.group-title text { color: #718096; font-size: 26rpx; }
.row { margin-top: 10rpx; font-size: 26rpx; }
.empty { text-align: center; color: #718096; padding: 24rpx; font-size: 26rpx; }
.history { border-top: 1rpx solid #eef1f5; padding-top: 16rpx; margin-top: 16rpx; font-size: 27rpx; }
