<view class="page"><view class="hero"><view class="heading">{{pick ? '选择收货地址' : '收货地址簿'}}</view><button class="small" bindtap="edit" disabled="{{busy}}">新增地址</button></view>
  <view wx:if="{{loading}}" class="state">正在加载地址…</view><view wx:elif="{{error}}" class="state error">{{error}}<button bindtap="load">重试</button></view><view wx:elif="{{!addresses.length}}" class="state">还没有地址，请添加收货地址</view>
  <view wx:for="{{addresses}}" wx:key="addressId" class="card"><view data-id="{{item.addressId}}" bindtap="select"><view class="row"><text class="title">{{item.receiverName}}</text><text>{{item.receiverPhone}}</text></view><view class="muted">{{item.provinceName}}{{item.cityName}}{{item.districtName}}{{item.detailAddress}}</view><text wx:if="{{item.isDefault === '1'}}" class="tag">默认地址</text><view wx:if="{{pick}}" class="muted">点击地址选择</view></view><view class="actions"><button class="small" data-id="{{item.addressId}}" bindtap="edit" disabled="{{busy}}">编辑</button><button class="small" data-id="{{item.addressId}}" data-action="default" bindtap="operate" disabled="{{busy || item.isDefault === '1'}}">设为默认</button><button class="small" data-id="{{item.addressId}}" data-action="delete" bindtap="operate" disabled="{{busy}}">删除</button></view></view>
  <view wx:if="{{showForm}}" class="card address-editor"><view class="title">{{form.addressId ? '编辑地址' : '新增地址'}}</view><view class="label">收货人</view><input value="{{form.receiverName}}" maxlength="50" data-field="receiverName" bindinput="input" disabled="{{busy}}"/><view class="label">手机号</view><input value="{{form.receiverPhone}}" type="number" maxlength="11" data-field="receiverPhone" bindinput="input" disabled="{{busy}}"/><view class="label">省市区</view><picker mode="region" value="{{region}}" bindchange="regionChange" disabled="{{busy}}"><view class="picker">{{form.provinceName ? form.provinceName + ' ' + form.cityName + ' ' + form.districtName : '请选择省市区'}}</view></picker><view class="label">详细地址</view><textarea value="{{form.detailAddress}}" maxlength="200" data-field="detailAddress" bindinput="input" disabled="{{busy}}"/><view class="label">邮编（选填）</view><input value="{{form.postalCode}}" maxlength="10" data-field="postalCode" bindinput="input" disabled="{{busy}}"/>
    <view wx:if="{{pick && !form.addressId}}" class="row"><text>保存到地址簿（选填）</text><switch checked="{{saveToBook}}" disabled="{{busy}}" bindchange="saveToBookChange"/></view><view wx:if="{{pick && !form.addressId && !saveToBook}}" class="muted">仅用于本次订单，不新增地址簿记录。</view>
    <view wx:if="{{!pick || form.addressId || saveToBook}}" class="row"><text>设为默认</text><switch checked="{{form.isDefault === '1'}}" disabled="{{busy}}" bindchange="defaultChange"/></view><view class="actions"><button disabled="{{busy}}" bindtap="closeForm">取消</button><button class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="save">{{pick && !form.addressId && !saveToBook ? '使用此地址' : '保存地址'}}</button></view></view>
</view>
