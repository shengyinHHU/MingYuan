@import "../../styles/number-badge.wxss";

page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
}

.home {
  height: 100vh;
  box-sizing: border-box;
}

.hero {
  position: relative;
  margin: 0 24rpx 24rpx;
  padding: 28rpx 28rpx 34rpx;
  overflow: hidden;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 50%, #fff4df 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.hero::after {
  content: "";
  position: absolute;
  right: -90rpx;
  bottom: -110rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(246, 166, 35, 0.16);
}

.hero-top {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.logo {
  width: 380rpx;
  max-height: 118rpx;
}

.tag {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(16, 82, 155, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.78);
  color: #0f4f9a;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-copy {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
}

.role-switch {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 10rpx;
  margin-top: 28rpx;
  padding: 8rpx;
  overflow-x: auto;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  white-space: nowrap;
}

.role-chip {
  flex: 0 0 auto;
  min-width: 116rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  color: #526175;
  font-size: 23rpx;
  line-height: 56rpx;
  text-align: center;
  font-weight: 700;
}

.role-chip.active {
  background: #0f58a8;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(15, 88, 168, 0.22);
}

.eyebrow {
  color: #f09a16;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 12rpx;
  color: #0b326a;
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
}

.stats {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.stat {
  flex: 1;
  min-height: 116rpx;
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.82);
  box-sizing: border-box;
}

.stat-value {
  color: #103f86;
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
}

.stat-value text {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.stat-label {
  margin-top: 12rpx;
  color: #657184;
  font-size: 22rpx;
}

.section {
  margin: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #172033;
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
}

.action-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.action-card {
  width: calc(25% - 16rpx);
  min-height: 132rpx;
  margin: 8rpx;
  padding: 20rpx 10rpx 16rpx;
  border: 1rpx solid rgba(18, 41, 72, 0.06);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.06);
  box-sizing: border-box;
  text-align: center;
}

.action-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.action-disabled {
  opacity: 0.45;
}

.action-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  margin: 0 auto 12rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.action-title {
  color: #1c2738;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}

.course-pending-message { margin-top:16rpx; color:#657184; font-size:22rpx; line-height:1.6; }
.pending-retry { margin-left:14rpx; color:#0f58a8; }

.blue .action-icon { background: #0f58a8; }
.green .action-icon { background: #20a06b; }
.orange .action-icon { background: #f19a19; }
.cyan .action-icon { background: #1598b7; }
.violet .action-icon { background: #7f63d7; }
.gold .action-icon { background: #d99b16; }
.red .action-icon { background: #df6557; }
.indigo .action-icon { background: #3656b3; }

.split {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-bottom: 44rpx;
}

.panel {
  padding: 24rpx;
  border: 1rpx solid rgba(18, 41, 72, 0.06);
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.05);
}

.course {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  min-height: 104rpx;
  margin-top: 18rpx;
}

.course-time-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 140rpx;
  flex: 0 0 auto;
  padding-top: 2rpx;
}

.course-meta-date {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #c27a08;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
}

.course-meta-sep {
  opacity: 0.55;
  color: #c27a08;
}

.course-time {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 64rpx;
  padding: 0 6rpx;
  border-radius: 12rpx;
  background: #eef5ff;
  color: #0f58a8;
  font-size: 24rpx;
  font-weight: 700;
}

.course-main {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.course-name {
  color: #172033;
  font-size: 27rpx;
  line-height: 1.3;
  font-weight: 700;
}

.course-meta {
  margin-top: 8rpx;
  color: #7b8798;
  font-size: 22rpx;
  line-height: 1.3;
}

.course-status {
  align-self: center;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff3dc;
  color: #c27a08;
  font-size: 21rpx;
  font-weight: 700;
}

.teacher-switch {
  margin-top: 16rpx;
  color: #0f58a8;
  font-size: 26rpx;
}
