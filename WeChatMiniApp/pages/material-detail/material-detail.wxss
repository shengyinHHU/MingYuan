page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
}

.page {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.hero {
  margin: 0 24rpx 22rpx;
  padding: 40rpx 28rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 56%, #fff3db 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.hero-tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  background: rgba(15, 88, 168, 0.12);
  color: #0f58a8;
  font-size: 22rpx;
}

.hero-title {
  margin-top: 20rpx;
  color: #0b326a;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.4;
}

.hero-price {
  margin-top: 16rpx;
  color: #e6532a;
  font-size: 48rpx;
  font-weight: 800;
}

.hero-meta {
  margin-top: 12rpx;
  color: #59687d;
  font-size: 24rpx;
}

.section {
  margin: 0 24rpx 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(20, 50, 90, 0.06);
}

.section-title {
  margin-bottom: 14rpx;
  color: #172033;
  font-size: 28rpx;
  font-weight: 700;
}

.intro {
  color: #59687d;
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.file-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.file-name {
  flex: 1;
  color: #172033;
  font-size: 26rpx;
  word-break: break-all;
}

.file-size {
  margin-left: 18rpx;
  color: #8993a4;
  font-size: 24rpx;
  flex-shrink: 0;
}

.uploader {
  color: #59687d;
  font-size: 26rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 18rpx rgba(20, 50, 90, 0.08);
}

.btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: #0f58a8;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.btn[disabled] {
  background: #9bb6d8;
  color: #ffffff;
}

.hint {
  text-align: center;
  color: #8993a4;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  color: #8993a4;
  font-size: 26rpx;
}
