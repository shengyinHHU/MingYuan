<view class="page">
  <view class="state" wx:if="{{loading}}">正在核对最新账单…</view><view class="state error" wx:if="{{error}}">{{error}}<button class="small" bindtap="onPullDownRefresh">刷新状态</button></view>
  <block wx:if="{{detail}}">
    <view class="hero"><view class="heading">{{detail.courseClassName}}</view><view class="muted">{{detail.studentName}} · {{detail.campusName}}</view><view class="muted number">{{detail.enrollmentCode}}</view><view class="tag">{{detail.statusText}} · {{detail.payStatus || '待核实'}}</view></view>
    <view class="safe" wx:if="{{detail.financeMode === 'MOCK'}}">模拟账单 · 不涉及真实资金</view>
    <view class="notice" wx:if="{{detail.billingStatus === 'HISTORY_PENDING'}}">历史费用待财务凭证核验。未知金额不是0元，也不代表欠费；请联系校区财务。</view><view class="notice" wx:if="{{detail.billingStatus === 'PENDING_PRICE'}}">课程费用尚未核定，请等待财务核价。</view>
    <view class="card"><view class="title">费用明细</view><view class="amount-grid"><view><view class="muted">核定原价</view><view class="value">{{detail.originalText}}</view></view><view><view class="muted">优惠抵扣</view><view class="value">{{detail.discountText}}</view></view><view><view class="muted">应付</view><view class="value">{{detail.payableText}}</view></view><view><view class="muted">待缴</view><view class="value">{{detail.dueText}}</view></view><view><view class="muted">实际已收</view><view class="value">{{detail.receivedText}}</view></view><view><view class="muted">已退</view><view class="value">{{detail.refundedText}}</view></view><view><view class="muted">净收款</view><view class="value">{{detail.netText}}</view></view><view><view class="muted">可申请退款</view><view class="value">{{detail.refundableText}}</view></view></view><view class="muted">退款不会产生新的欠费，优惠抵扣不属于可退现金。</view></view>
    <view class="card" wx:if="{{detail.canPay}}"><view class="title">确认费用</view><picker disabled="{{submitting || retrying}}" range="{{couponOptions}}" value="{{couponIndex}}" bindchange="chooseCoupon"><view class="picker">{{couponOptions[couponIndex]}} ▾</view></picker><view class="muted" wx:for="{{coupons}}" wx:key="userCouponId">{{item.couponName}}：满{{item.minSpendText}}，{{item.scopeText}}；{{item.validFrom}} 至 {{item.validUntil}}</view><block wx:if="{{quote}}"><view class="row"><view>试算优惠</view><view>{{quote.discountText}}</view></view><view class="row"><view>本次应付</view><view class="price">{{quote.payableText}}</view></view><view class="safe" wx:if="{{retrying}}">上次请求结果未确定，将重试同一金额与优惠券。</view><button class="primary" loading="{{submitting}}" disabled="{{submitting || loading}}" wx:if="{{quote.isFree || (detail.financeMode === 'MOCK' && detail.mockAllowed)}}" bindtap="pay">{{quote.isFree ? '确认费用减免' : (retrying ? '重试原模拟请求' : '本地模拟缴费')}}</button></block><view class="notice" wx:if="{{detail.financeMode === 'REAL' && (!quote || !quote.isFree)}}">微信在线支付尚未开通。请联系校区财务，按约定方式线下缴费，并提供报名编号。财务留证确认后，本页更新缴费状态与收据。</view></view>
    <view class="notice" wx:if="{{detail.activePayment}}">已有待核对付款：{{detail.activePayment.paymentNo}}。请勿重复缴费。结果未知时须先查询或由财务核对。<button class="small" loading="{{submitting}}" disabled="{{submitting}}" bindtap="resumePayment">{{detail.activePayment.channel === 'MOCK' && detail.activePayment.paymentStatus === 'PENDING' ? '继续本地模拟确认' : '查询付款状态'}}</button></view>
    <view class="card"><view class="title">付款记录</view><view class="timeline" wx:for="{{detail.payments}}" wx:key="paymentId"><view class="row"><view>{{item.statusText}}</view><view>{{item.amountText}}</view></view><view class="muted number">{{item.paymentNo}}</view><view class="muted">{{item.channelText}} · {{item.paidTime || item.createTime}}</view><view class="muted">{{item.failureReason}}</view></view><view class="muted" wx:if="{{!detail.payments.length}}">暂无缴费记录</view></view>
    <view class="actions"><button bindtap="receipts">收据 / 减免单</button><button bindtap="refunds">{{detail.canRefund ? '申请退费' : '退费记录'}}</button></view><button class="small" wx:if="{{detail.canCancel && !retrying}}" bindtap="cancelEnrollment" disabled="{{submitting || loading}}">取消未缴费报名</button><view class="card" wx:if="{{detail.refunds.length}}"><view class="title">退费进度</view><view class="timeline" wx:for="{{detail.refunds}}" wx:key="refundId"><view class="row"><view>{{item.kindText}}</view><view>{{item.statusText}}</view></view><view class="muted">申请 {{item.requestedText}} · 批准 {{item.approvedText}}</view><view class="muted">{{item.reason}}</view></view></view>
  </block>
</view>
