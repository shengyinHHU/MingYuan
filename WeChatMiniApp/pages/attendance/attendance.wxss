page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
}

.page {
  min-height: 100vh;
  padding-bottom: 54rpx;
}

.header {
  margin: 0 24rpx 22rpx;
  padding: 30rpx 28rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 56%, #fff3db 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.logo {
  width: 320rpx;
}

.title {
  margin-top: 22rpx;
  color: #0b326a;
  font-size: 44rpx;
  font-weight: 800;
}

.summary,
.course-card,
.empty {
  margin: 24rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.05);
}

.summary-value {
  color: #0f58a8;
  font-size: 48rpx;
  font-weight: 800;
}

.summary-label {
  margin-top: 8rpx;
  color: #647286;
  font-size: 24rpx;
  font-weight: 700;
}

.card-head,
.foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.course-name {
  flex: 1;
  color: #172033;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 800;
}

.count {
  color: #0f58a8;
  font-size: 32rpx;
  font-weight: 800;
}

.meta {
  margin-top: 10rpx;
  color: #6e7a8c;
  font-size: 23rpx;
}

.progress {
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e7ecf4;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0f58a8, #f2a22a);
}

.foot {
  margin-top: 14rpx;
  color: #7b8798;
  font-size: 23rpx;
  font-weight: 700;
}

.empty {
  text-align: center;
}

.empty-title {
  color: #778397;
  font-size: 27rpx;
  font-weight: 700;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(8, 22, 40, 0.42);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  max-height: 74vh;
  padding: 30rpx 28rpx 42rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(9, 25, 48, 0.18);
  box-sizing: border-box;
}

.sheet-title {
  color: #172033;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
}

.sheet-subtitle {
  margin-top: 10rpx;
  color: #647286;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-list {
  max-height: 56vh;
  margin-top: 18rpx;
}

.detail-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f6;
}

.lesson-no {
  width: 96rpx;
  color: #0f58a8;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-main {
  flex: 1;
  min-width: 0;
}

.detail-time {
  color: #172033;
  font-size: 25rpx;
  font-weight: 800;
}

.detail-meta {
  margin-top: 8rpx;
  color: #7b8798;
  font-size: 22rpx;
}

.status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eef1f5;
  color: #7a8492;
  font-size: 22rpx;
  font-weight: 800;
}

.status.done {
  background: #eaf7f1;
  color: #15875d;
}
