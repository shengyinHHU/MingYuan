@import "../../utils/material-shop.wxss";
.filters { display: flex; gap: 10rpx; align-items: center; margin-bottom: 20rpx; }
.filters picker { flex: 1; }
.filters .picker { font-size: 23rpx; padding: 14rpx 8rpx; margin: 0; white-space: nowrap; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.product { box-sizing: border-box; width: 48.5%; padding: 16rpx; }
.product-cover { width: 100%; height: 270rpx; border-radius: 14rpx; background: #eaf3ff; }
.product-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; height: 84rpx; line-height: 42rpx; font-weight: 700; margin: 12rpx 0; }
.product .price { margin-top: 12rpx; font-size: 32rpx; }
