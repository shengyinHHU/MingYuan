<view class="page">
  <view class="header">
    <view class="header-title">资料商城</view>
    <view class="header-subtitle">学科精品资料 · 付费下载</view>
  </view>

  <view class="filter-bar">
    <picker class="filter-picker" bindchange="onSubjectChange" value="{{subjectIndex}}" range="{{subjectOptions}}">
      <view class="filter-text">{{subjectOptions[subjectIndex]}}</view>
    </picker>
    <picker class="filter-picker" bindchange="onGradeChange" value="{{gradeIndex}}" range="{{gradeOptions}}">
      <view class="filter-text">{{gradeOptions[gradeIndex]}}</view>
    </picker>
    <input class="filter-input" placeholder="搜索标题" value="{{keyword}}" bindinput="onKeyword" confirm-type="search" bindconfirm="loadList" />
    <view class="icon-btn reset" bindtap="resetFilters">重置</view>
  </view>

  <view class="section" wx:if="{{!showEmpty}}">
    <view class="material-card" wx:for="{{list}}" wx:key="materialId" data-id="{{item.materialId}}" bindtap="openDetail">
      <view class="cover">{{item.subjectText || '资'}}</view>
      <view class="info">
        <view class="title">{{item.title}}</view>
        <view class="meta">
          <text class="tag">{{item.subjectText}}</text>
          <text class="tag">{{item.gradeText}}</text>
          <text class="size" wx:if="{{item.sizeText}}">{{item.sizeText}}</text>
        </view>
        <view class="sale">已售 {{item.saleCount || 0}} 份</view>
      </view>
      <view class="right">
        <view class="price {{item.priceText === '免费' ? 'free' : ''}}">{{item.priceText}}</view>
        <view class="badge" wx:if="{{item.bought}}">已购买</view>
        <view class="badge buy" wx:else>去查看</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{showEmpty && !loading}}">
    <view class="empty-icon">📚</view>
    <view class="empty-text">暂无符合条件的资料</view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
