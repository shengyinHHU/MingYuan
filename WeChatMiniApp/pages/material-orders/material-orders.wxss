page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
}

.page {
  min-height: 100vh;
  padding-bottom: 56rpx;
}

.header {
  margin: 0 24rpx 22rpx;
  padding: 36rpx 28rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 56%, #fff3db 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.header-title {
  color: #0b326a;
  font-size: 44rpx;
  font-weight: 800;
}

.header-subtitle {
  margin-top: 12rpx;
  color: #59687d;
  font-size: 25rpx;
}

.list {
  margin: 0 24rpx;
}

.order-card {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(20, 50, 90, 0.06);
}

.order-main {
  flex: 1;
  min-width: 0;
}

.title {
  color: #172033;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  margin-top: 10rpx;
  color: #8993a4;
  font-size: 22rpx;
}

.meta .code {
  margin-right: 14rpx;
}

.order-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  margin-left: 18rpx;
  flex-shrink: 0;
}

.amount {
  color: #e6532a;
  font-size: 30rpx;
  font-weight: 800;
}

.amount.free {
  color: #1aa56c;
}

.status {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status.paid {
  background: #e6f7ee;
  color: #1aa56c;
}

.status.unpaid {
  background: #fff3e0;
  color: #b56b00;
}

.status.refund {
  background: #fdeaea;
  color: #c93b3b;
}

.btn-download {
  margin-top: 4rpx;
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: #0f58a8;
  color: #ffffff;
  font-size: 22rpx;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #8993a4;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  margin-top: 16rpx;
  font-size: 26rpx;
}

.empty-action {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 32rpx;
  border-radius: 16rpx;
  background: #0f58a8;
  color: #ffffff;
  font-size: 26rpx;
}

.loading {
  padding: 40rpx 0;
  text-align: center;
  color: #8993a4;
  font-size: 24rpx;
}
