<view class="page">
  <view class="header">
    <view class="header-title">出勤审核</view>
    <view class="header-subtitle">教师提交点名 → 教务核对教师与出勤 → 一次确认归档</view>
    <view class="header-subtitle">当前范围：待确认 {{pendingCount}} 场 · 已确认 {{confirmedCount}} 场</view>
  </view>

  <view class="filter-bar">
    <picker mode="date" value="{{filterDate}}" bindchange="onDateFilter">
      <view class="filter-date">{{filterDate || '按日期筛选'}} ▾</view>
    </picker>
    <view class="filter-reset" bindtap="resetFilter" wx:if="{{filterDate}}">重置</view>
  </view>

  <view class="filter-bar"><view class="filter-reset" wx:for="{{filters}}" wx:key="*this" data-index="{{index}}" bindtap="changeFilter">{{filterIndex === index ? '● ' : ''}}{{item}}</view></view>
  <view class="empty" wx:if="{{error}}">{{error}}<button size="mini" bindtap="loadList">刷新</button></view>
  <view class="list" wx:if="{{!showEmpty}}">
    <view class="card" wx:for="{{list}}" wx:key="rowKey"
      data-schedule-id="{{item.scheduleId}}" data-date="{{item.dateText}}"
      data-course="{{item.course}}" data-room="{{item.room}}" bindtap="openDetail">
      <view class="card-top">
        <view class="course">{{item.course || '未命名课程'}}</view>
        <view class="badge {{item.reviewClass}}">{{item.reviewText}}</view>
      </view>
      <view class="meta">
        <text class="date">{{item.dateText}}</text>
        <text class="tag" wx:if="{{item.periodName}}">{{item.periodName}}</text>
        <text class="tag" wx:if="{{item.timeSlot}}">{{item.timeSlot}}</text>
        <text class="room" wx:if="{{item.room}}">{{item.room}}</text>
      </view>
      <view class="footer">
        <text class="teacher" wx:if="{{item.teacherName}}">{{item.teacherName}}</text>
        <text class="count">实到 {{item.actualCount || 0}}/{{item.totalCount || 0}} 人</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{showEmpty && !loading}}">
    <view class="empty-icon">🗂️</view>
    <view class="empty-text">当前范围暂无课次记录</view>
  </view>

  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
