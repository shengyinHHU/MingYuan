page {
  min-height: 100vh;
  background: #f4f7fb;
  color: #172033;
}

.page {
  min-height: 100vh;
  padding-bottom: 56rpx;
}

.header {
  margin: 0 24rpx 22rpx;
  padding: 30rpx 28rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: linear-gradient(145deg, #ffffff 0%, #eaf3ff 56%, #fff3db 100%);
  box-shadow: 0 18rpx 46rpx rgba(13, 76, 145, 0.12);
}

.logo {
  width: 320rpx;
}

.header-title {
  margin-top: 22rpx;
  color: #0b326a;
  font-size: 44rpx;
  font-weight: 800;
}

.header-subtitle {
  margin-top: 12rpx;
  color: #59687d;
  font-size: 25rpx;
  line-height: 1.55;
}

.filter-bar {
  display: flex;
  gap: 12rpx;
  margin: 0 24rpx 22rpx;
  align-items: center;
}

.filter-picker {
  flex: 1;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce5f2;
  border-radius: 14rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.filter-text {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 25rpx;
  color: #172033;
}

.icon-btn {
  width: 88rpx;
  height: 72rpx;
  padding: 0;
  border-radius: 14rpx;
  background: #ffffff;
  color: #526175;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: center;
}

.icon-btn.reset {
  border: 1rpx solid #dce5f2;
}

.section {
  margin: 24rpx;
}

.section-title {
  margin-bottom: 16rpx;
  color: #172033;
  font-size: 32rpx;
  font-weight: 800;
}

.schedule-card,
.enroll-card {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(18, 41, 72, 0.06);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(24, 43, 77, 0.05);
}

.schedule-card:active {
  transform: scale(0.99);
}

.card-main {
  flex: 1;
  min-width: 0;
}

.card-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  justify-content: space-between;
}

.course-name {
  color: #172033;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
}

.meta {
  margin-top: 8rpx;
  color: #6e7a8c;
  font-size: 23rpx;
  line-height: 1.35;
}

.count {
  color: #0b326a;
  font-size: 26rpx;
  font-weight: 800;
}

.status,
.done {
  margin-top: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.status.ok,
.done {
  background: #eaf7f1;
  color: #15875d;
}

.status.disabled {
  background: #eef1f5;
  color: #7a8492;
}

.empty {
  padding: 42rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #778397;
  font-size: 25rpx;
  text-align: center;
}

.mask {
  position: fixed;
  inset: 0;
  z-index: 10;
  background: rgba(8, 22, 40, 0.42);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 11;
  padding: 30rpx 28rpx 42rpx;
  border-radius: 24rpx 24rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(9, 25, 48, 0.18);
}

.sheet-title {
  color: #172033;
  font-size: 34rpx;
  font-weight: 800;
}

.sheet-course {
  margin-top: 14rpx;
  color: #0b326a;
  font-size: 29rpx;
  font-weight: 800;
}

.sheet-meta {
  margin-top: 8rpx;
  color: #6e7a8c;
  font-size: 24rpx;
}

.field {
  margin-top: 24rpx;
}

.label {
  margin-bottom: 10rpx;
  color: #334257;
  font-size: 24rpx;
  font-weight: 700;
}

.input {
  height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid #dce5f2;
  border-radius: 14rpx;
  background: #f9fbff;
  font-size: 26rpx;
  box-sizing: border-box;
}

.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cancel-btn,
.submit-btn {
  flex: 1;
  height: 86rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 86rpx;
}

.cancel-btn {
  background: #eef2f7;
  color: #526175;
}

.submit-btn {
  background: #0f58a8;
  color: #ffffff;
}

.teacher-filter { margin: 0 24rpx 22rpx; padding: 20rpx; border-radius: 14rpx; background: white; }
.teacher-filter-title { color: #0b326a; font-size: 26rpx; font-weight: 700; }
.teacher-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.teacher-tag { margin-top: 14rpx; padding: 10rpx 14rpx; border-radius: 12rpx; color: #0f58a8; background: #eaf3ff; font-size: 23rpx; }
.teacher-search { margin-top: 18rpx; height: 72rpx; font-size: 25rpx; border-bottom: 1rpx solid #dce5f2; }
.teacher-clear { padding: 18rpx 0; color: #0f58a8; font-size: 24rpx; }
.teacher-options { max-height: 360rpx; }
.teacher-option { padding: 18rpx 10rpx; font-size: 25rpx; }
.teacher-option.selected { background: #eaf3ff; color: #0f58a8; }
.teacher-group-title { margin: 24rpx 0 14rpx; font-size: 27rpx; font-weight: 700; color: #0b326a; }

.teacher-tag, .teacher-option, .teacher-group-title { white-space: normal; word-break: break-all; }
