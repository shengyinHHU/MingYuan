<view class="page"><view class="hero"><view class="heading">课程退费</view><view class="muted">审核通过后须财务执行，退款成功才代表完成。</view></view><view class="state error" wx:if="{{error}}">{{error}}<button class="small" bindtap="onPullDownRefresh">刷新</button></view>
  <view class="card" wx:if="{{detail}}"><view class="title">{{detail.courseClassName}} · {{detail.studentName}}</view><view class="row"><view>实际已收</view><view>{{detail.receivedText}}</view></view><view class="row"><view>已退</view><view>{{detail.refundedText}}</view></view><view class="row"><view>当前可申请</view><view class="price">{{detail.refundableText}}</view></view><view class="safe" wx:if="{{detail.financeMode === 'MOCK'}}">模拟退款 · 不涉及真实资金</view><view class="notice" wx:if="{{!detail.canRefund && !retrying}}">暂无可申请退款金额，或正在处理一条申请。零元减免的退课请联系校区办理。</view><block wx:if="{{detail.canRefund || retrying}}"><view class="notice" wx:if="{{retrying}}">上次申请结果未确定，请重试原申请。金额与原因已保留。</view><view class="label">退费类型</view><picker range="{{kindOptions}}" value="{{kindIndex}}" disabled="{{submitting || retrying}}" bindchange="kind"><view class="picker">{{kindOptions[kindIndex]}} ▾</view></picker><view class="label">申请金额（元）</view><input type="digit" value="{{amount}}" data-field="amount" bindinput="input" disabled="{{submitting || retrying}}" placeholder="请输入正数，最多两位小数"/><view class="label">退费原因</view><textarea value="{{reason}}" data-field="reason" bindinput="input" maxlength="500" disabled="{{submitting || retrying}}" placeholder="说明退费原因，退课请注明实际情况"/><button class="primary" bindtap="apply" loading="{{submitting}}" disabled="{{submitting || loading}}">{{retrying ? '重试原申请' : '提交退费申请'}}</button></block></view>
  <view class="section-title">退费记录</view><view class="card" wx:for="{{rows}}" wx:key="refundId"><view class="row"><view class="title">{{item.kindText}}</view><view class="tag">{{item.statusText}}</view></view><view class="muted number">{{item.refundNo}}</view><view class="row"><view>申请金额</view><view>{{item.requestedText}}</view></view><view class="row"><view>批准金额</view><view>{{item.approvedText}}</view></view><view class="muted">原因：{{item.reason}}</view><view class="muted">审核说明：{{item.reviewRemark || '尚无'}}</view><view class="muted">完成时间：{{item.completedTime || '尚未完成'}}</view><view class="muted">{{item.failureReason}}</view><view class="safe" wx:if="{{item.financeMode === 'MOCK'}}">模拟 · 不涉及真实资金</view><button class="small" wx:if="{{item.canCancel}}" data-id="{{item.refundId}}" bindtap="cancel" disabled="{{submitting}}">撤回未审核申请</button></view>
  <view class="state" wx:if="{{loading}}">正在加载…</view><view class="state" wx:if="{{!loading && !error && !rows.length}}">暂无退费记录</view>
</view>
