<view class="page"><view class="hero"><view class="brand"><image class="logo" src="/images/logo.png" mode="aspectFit"/><view class="heading">收费财务</view></view><view class="muted">收费记录、线下凭证与确认。历史核验、退款审批和批量发券请使用管理网页。</view></view><view class="state error" wx:if="{{error}}">{{error}}<button class="small" bindtap="onPullDownRefresh">刷新</button></view>
  <block wx:if="{{!detail}}"><input value="{{searchText}}" data-field="searchText" bindinput="input" bindconfirm="search" placeholder="按学生姓名查询"/><view class="row"><picker class="grow" range="{{filters}}" value="{{filterIndex}}" bindchange="filter"><view class="picker">{{filters[filterIndex]}} ▾</view></picker><button class="primary small" bindtap="search" disabled="{{loading}}">查询</button></view><view class="card" wx:for="{{rows}}" wx:key="enrollmentId" data-id="{{item.enrollmentId}}" bindtap="detail"><view class="row"><view class="title">{{item.courseClassName}}</view><view class="tag">{{item.statusText}}</view></view><view class="muted">{{item.studentName}} · {{item.parentName}} · {{item.campusName}}</view><view class="muted number">{{item.enrollmentCode}}</view><view class="safe" wx:if="{{item.financeMode === 'MOCK'}}">模拟 · 不涉及真实资金</view><view class="amount-grid"><view><view class="muted">应付 / 待缴</view><view class="value">{{item.payableText}} / {{item.dueText}}</view></view><view><view class="muted">已收 / 已退</view><view class="value">{{item.receivedText}} / {{item.refundedText}}</view></view></view><view class="link" wx:if="{{allowed.query}}">收费详情 ›</view></view></block>
  <block wx:if="{{detail}}"><view class="card"><view class="title">{{detail.courseClassName}}</view><view class="muted">{{detail.studentName}} · {{detail.parentName}} · {{detail.campusName}}</view><view class="muted number">{{detail.enrollmentCode}}</view><view class="tag">{{detail.statusText}} · {{detail.payStatus || '待核实'}}</view><view class="safe" wx:if="{{detail.financeMode === 'MOCK'}}">模拟账单 · 不涉及真实资金</view><view class="amount-grid"><view><view class="muted">原价 / 优惠</view><view class="value">{{detail.originalText}} / {{detail.discountText}}</view></view><view><view class="muted">应付 / 待缴</view><view class="value">{{detail.payableText}} / {{detail.dueText}}</view></view><view><view class="muted">实收 / 已退</view><view class="value">{{detail.receivedText}} / {{detail.refundedText}}</view></view><view><view class="muted">净收 / 可退</view><view class="value">{{detail.netText}} / {{detail.refundableText}}</view></view></view></view>
  <view class="notice" wx:if="{{detail.billingStatus === 'HISTORY_PENDING'}}">历史账单金额待核验，请使用网页专用历史核验流程，附凭证和实际时间。不能按0元处理或普通核价。</view>
  <view class="card" wx:if="{{allowed.price && detail.billingStatus !== 'HISTORY_PENDING' && !detail.payments.length && detail.billingStatus !== 'CLOSED'}}"><view class="title">核定费用</view><input type="digit" value="{{price}}" data-field="price" bindinput="input" placeholder="核定原价（元）"/><picker range="{{modeLabels}}" value="{{modeIndex}}" bindchange="mode" disabled="{{submitting}}"><view class="picker">{{modeLabels[modeIndex]}} ▾</view></picker><button class="primary" bindtap="savePrice" loading="{{submitting}}" disabled="{{submitting || loading}}">确认核价</button></view>
  <view class="card" wx:if="{{allowed.collect || allowed.confirm}}"><view class="title">收款凭证与实际信息</view><view class="label">实际付款人</view><input value="{{payerName}}" data-field="payerName" bindinput="input" placeholder="实际付款人姓名"/><view class="label">实际收款时间</view><input value="{{paidTime}}" data-field="paidTime" bindinput="input" placeholder="yyyy-MM-dd HH:mm:ss"/><view class="label">完整流水参考号</view><input value="{{providerTradeNo}}" data-field="providerTradeNo" bindinput="input" placeholder="转账渠道须可核对，现金可空"/><button class="small" wx:if="{{allowed.collect}}" bindtap="chooseEvidence" disabled="{{submitting}}">选择私有PDF / 图片凭证</button><view class="muted">{{evidenceName}}</view><block wx:if="{{allowed.collect && detail.canPay}}"><picker range="{{channelLabels}}" value="{{channelIndex}}" bindchange="channel" disabled="{{submitting}}"><view class="picker">{{channelLabels[channelIndex]}} ▾</view></picker><view class="notice">线下已实际收款才登记，随后核对确认。零元账单生成费用减免确认单。</view><button class="primary" bindtap="collect" loading="{{submitting}}" disabled="{{submitting || loading}}">登记收款 / 重试原登记</button></block><view class="label">关闭未成功付款原因</view><input value="{{closeReason}}" data-field="closeReason" bindinput="input" placeholder="必须核对没有实际收款，保留原因"/></view>
  <view class="section-title">付款记录</view><view class="card" wx:for="{{detail.payments}}" wx:key="paymentId"><view class="row"><view class="title">{{item.statusText}} · {{item.channelText}}</view><view>{{item.amountText}}</view></view><view class="muted number">{{item.paymentNo}}</view><view class="muted">付款人 {{item.payerName}} · {{item.paidTime}}</view><view class="muted number">流水 {{item.providerTradeNo || '无'}} · {{item.evidenceKey ? '已留凭证' : '无凭证'}}</view><view class="muted">{{item.failureReason}}</view><view class="actions" wx:if="{{item.paymentStatus === 'PENDING' || item.paymentStatus === 'UNKNOWN'}}"><button class="primary small" wx:if="{{allowed.confirm}}" data-id="{{item.paymentId}}" data-action="confirm" bindtap="paymentAction" disabled="{{submitting}}">核对并确认</button><button class="small" wx:if="{{allowed.collect}}" data-id="{{item.paymentId}}" data-action="close" bindtap="paymentAction" disabled="{{submitting}}">核对后关闭</button></view></view>
  <view class="section-title">收据</view><view class="card" wx:for="{{detail.receipts}}" wx:key="receiptId"><view class="row"><view>{{item.title}} · {{item.statusText}}</view><view>{{item.amountText}}</view></view><view class="muted number">{{item.receiptNo}} · {{item.fileText}}</view><button class="small" wx:if="{{allowed.download && item.canDownload}}" data-id="{{item.receiptId}}" bindtap="receipt">查看PDF</button></view>
  <view class="section-title">退费记录</view><view class="card" wx:for="{{detail.refunds}}" wx:key="refundId"><view class="row"><view>{{item.kindText}}</view><view>{{item.statusText}}</view></view><view class="muted">申请 {{item.requestedText}} · 批准 {{item.approvedText}}</view><view class="muted">{{item.reason}} · {{item.reviewRemark}}</view></view></block><view class="state" wx:if="{{loading}}">正在加载…</view><view class="state" wx:if="{{!loading && !error && !detail && !rows.length}}">暂无收费账单</view>
</view>
