<view class="page"><view class="header"><view class="header-title">{{detail.title || '作业详情'}}</view><view class="header-subtitle">{{detail.description || '请阅读作业说明并提交'}}</view></view>
<view class="card" wx:if="{{homeworkFiles.length}}"><view class="section-title">老师布置的附件</view><view wx:for="{{homeworkFiles}}" wx:key="filePath" class="file"><image wx:if="{{item.isImage}}" class="thumb" mode="aspectFill" src="{{item.url}}" data-url="{{item.url}}" bindtap="openFile"/><view wx:else class="pdf-chip" data-url="{{item.url}}" data-name="{{item.fileName}}" bindtap="openFile">PDF　{{item.showName}}</view></view></view>
<view class="card"><textarea class="answer" placeholder="请输入作业说明或完成情况" value="{{description}}" bindinput="inputDescription" disabled="{{submitted}}"/></view><view class="card"><view class="section-title">我的提交附件</view><button wx:if="{{!submitted}}" size="mini" bindtap="chooseImage">拍照/相册图片</button><button wx:if="{{!submitted}}" size="mini" bindtap="choosePdf">选择 PDF 文件</button><view wx:for="{{files}}" wx:key="filePath" class="file"><image wx:if="{{item.isImage}}" class="thumb" mode="aspectFill" src="{{item.url}}" data-url="{{item.url}}" bindtap="openFile"/><view wx:else class="pdf-chip" data-url="{{item.url}}" data-name="{{item.fileName}}" bindtap="openFile">PDF　{{item.showName}}</view><text wx:if="{{!submitted}}" class="remove" data-index="{{index}}" bindtap="removeFile">删除</text></view><view wx:if="{{submitted}}" class="success">已提交，每名学生每份作业只能提交一次</view></view><button wx:if="{{!submitted}}" class="submit" loading="{{submitting}}" bindtap="submit">提交作业</button></view>
