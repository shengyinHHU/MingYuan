<view class="page"><view class="header">{{editing ? '编辑作业草稿' : '创建作业草稿'}}</view><view class="card"><view class="hint">发布对象将在草稿发布时选择</view><input placeholder="作业标题" data-field="title" bindinput="input"/><textarea placeholder="作业说明" data-field="description" bindinput="input"/><picker mode="date" bindchange="dateChange"><view class="picker">截止日期：{{deadlineDate || '请选择'}}</view></picker><picker mode="time" bindchange="timeChange"><view class="picker">截止时间：{{deadlineTime || '请选择（精确到分钟）'}}</view></picker></view><view class="card"><view class="section">教师附件</view><view class="btn-row"><button size="mini" bindtap="chooseImage">拍照/相册图片</button><button size="mini" bindtap="chooseVideo">拍摄/选择视频</button><button size="mini" bindtap="chooseAudio">选择音频</button><button size="mini" bindtap="choosePdf">选择 PDF</button></view><view wx:for="{{files}}" wx:key="filePath" class="file"><text>{{item.fileName || item.filePath}}</text><text data-index="{{index}}" bindtap="removeFile">删除</text></view></view><button class="submit" loading="{{saving}}" bindtap="save">{{editing ? '保存修改' : '保存草稿'}}</button></view>