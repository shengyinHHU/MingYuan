<view class="page"><view class="header">提交列表</view><view class="summary"><text>班级人数 {{stats.total}}</text><text>已提交 {{stats.submitted}}</text><text class="pending">未提交 {{stats.pending}}</text></view><view class="card" wx:for="{{list}}" wx:key="enrollmentId" data-id="{{item.submissionId}}" bindtap="open"><view class="title">{{item.studentName || '学生'}}</view><view class="meta">{{item.missing ? '未提交' : ('提交时间：' + (item.submitTime || '-') + '　' + item.statusText)}}</view><view class="score">{{item.missing ? '-' : (item.finalScore === null || item.finalScore === undefined ? '-' : item.finalScore)}} 分</view></view><view class="empty" wx:if="{{!loading && !list.length}}">暂无提交</view><view class="loading" wx:if="{{loading}}">加载中...</view></view>