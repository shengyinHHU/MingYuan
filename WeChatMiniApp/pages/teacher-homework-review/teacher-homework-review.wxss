page{min-height:100vh;background:#f4f7fb}.page{padding:24rpx;color:#172033}.header{padding:24rpx;font-size:38rpx;font-weight:800}.summary{display:flex;justify-content:space-between;margin:0 0 20rpx;padding:20rpx 24rpx;background:#eaf3ff;border-radius:16rpx;color:#1768c2;font-size:24rpx}.summary .pending{color:#d97706}.card{position:relative;margin-bottom:20rpx;padding:24rpx;background:#fff;border-radius:20rpx;box-shadow:0 8rpx 24rpx #14325a0f}.title{font-size:30rpx;font-weight:700}.meta{margin-top:12rpx;color:#66748a;font-size:24rpx}.score{position:absolute;right:24rpx;top:28rpx;color:#1768c2;font-size:30rpx;font-weight:700}.empty,.loading{padding:100rpx;text-align:center;color:#8993a4}