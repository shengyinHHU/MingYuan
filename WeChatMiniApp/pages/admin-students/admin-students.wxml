<view class="page">
  <view class="search-bar">
    <input class="search-input" placeholder="搜索姓名/手机/年级/科目/教师" value="{{keyword}}" confirm-type="search" bindinput="onKeyword"/>
  </view>

  <view class="filter-tabs">
    <text wx:for="{{statusOptions}}" wx:key="value" class="tab {{filterStatus === item.value ? 'tab-active' : ''}}" data-value="{{item.value}}" bindtap="onStatus">{{item.label}}</text>
  </view>

  <view class="count-bar">共 {{total}} 条记录</view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{showEmpty}}" class="tip">暂无学生档案</view>

  <view wx:else class="list">
    <view class="row" wx:for="{{shown}}" wx:key="enrollmentId" data-id="{{item.enrollmentId}}" bindtap="openDetail">
      <view class="row-head">
        <text class="row-name">{{item.studentName}}</text>
        <text class="badge {{item.enrollmentStatus === '报名成功' ? 'ok' : 'gray'}}">{{item.enrollmentStatus}}</text>
      </view>
      <view class="row-sub">{{item.gradeName}} · {{item.subjectName}} · {{item.classType}}</view>
      <view class="row-sub">教师：{{item.teacherName}}　{{item.payStatus}}</view>
    </view>
    <view wx:if="{{hasMore}}" class="more-tip">上拉加载更多…</view>
    <view wx:else class="more-tip">没有更多了</view>
  </view>

  <view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{detail.studentName}} · 报名详情</text>
        <text class="sheet-close" bindtap="closeDetail">关闭</text>
      </view>
      <view class="info"><text class="info-k">报名编号</text><text class="info-v">{{detail.enrollmentCode}}</text></view>
      <view class="info"><text class="info-k">年级</text><text class="info-v">{{detail.gradeName}}</text></view>
      <view class="info"><text class="info-k">科目</text><text class="info-v">{{detail.subjectName}}</text></view>
      <view class="info"><text class="info-k">班型</text><text class="info-v">{{detail.classType}}</text></view>
      <view class="info"><text class="info-k">任课教师</text><text class="info-v">{{detail.teacherName}}</text></view>
      <view class="info"><text class="info-k">学生手机</text><text class="info-v">{{detail.studentPhone}}</text></view>
      <view class="info"><text class="info-k">联系手机</text><text class="info-v">{{detail.contactPhone}}</text></view>
      <view class="info"><text class="info-k">报名状态</text><text class="info-v">{{detail.enrollmentStatus}}</text></view>
      <view class="info"><text class="info-k">缴费状态</text><text class="info-v">{{detail.payStatus}}</text></view>
      <view class="info"><text class="info-k">报名时间</text><text class="info-v">{{detail.createTime}}</text></view>
      <view class="info"><text class="info-k">备注</text><text class="info-v">{{detail.remark}}</text></view>
    </view>
  </view>
</view>
